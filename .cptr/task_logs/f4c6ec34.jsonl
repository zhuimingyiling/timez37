{"type": "output", "data": "\r\n", "ts": 1790300051.555409}
{"type": "output", "data": "    // ==================== \u8bc6\u522b\u4e0e\u5206\u6790 ====================\r\n", "ts": 1790300051.555409}
{"type": "output", "data": "\r\n", "ts": 1790300051.555409}
{"type": "output", "data": "    private fun cropHint(frame: Frame): DoubleArray? {\r\n", "ts": 1790300051.555409}
{"type": "output", "data": "        val g = sessionGrid ?: return null\r\n", "ts": 1790300051.555409}
{"type": "output", "data": "        val x0 = g.nx0 * frame.width\r\n", "ts": 1790300051.555409}
{"type": "output", "data": "        val y0 = g.ny0 * frame.height\r\n        val x1 = g.nx1 * frame.width\r\n", "ts": 1790300051.555409}
{"type": "output", "data": "        val y1 = g.ny1 * frame.height\r\n        val mx = (x1 - x0) / 8.0 * 1.2\r\n", "ts": 1790300051.5559092}
{"type": "output", "data": "        val my = (y1 - y0) / 9.0 * 1.2\r\n        val cx0 = max(0.0, x0 - mx)\r\n", "ts": 1790300051.5559092}
{"type": "output", "data": "        val cy0 = max(0.0, y0 - my)\r\n", "ts": 1790300051.5559092}
{"type": "output", "data": "        val cx1 = min(frame.width.toDouble(), x1 + mx)\r\n", "ts": 1790300051.5559092}
{"type": "output", "data": "        val cy1 = min(frame.height.toDouble(), y1 + my)\r\n", "ts": 1790300051.5559092}
{"type": "output", "data": "        val w = ((cx1 - cx0).toInt() / 16) * 16\r\n", "ts": 1790300051.5559092}
{"type": "output", "data": "        val h = ((cy1 - cy0).toInt() / 16) * 16\r\n", "ts": 1790300051.5559092}
{"type": "output", "data": "        if (w < 64 || h < 64) return null\r\n", "ts": 1790300051.5559092}
{"type": "output", "data": "        return doubleArrayOf(cx0, cy0, cx0 + w, cy0 + h)\r\n    }\r\n", "ts": 1790300051.5564504}
{"type": "output", "data": "\r\n", "ts": 1790300051.5564504}
{"type": "output", "data": "    private fun handleFrame(frame: Frame) {\r\n", "ts": 1790300051.5564504}
{"type": "output", "data": "        if (paused || manualMode) return\r\n", "ts": 1790300051.5564504}
{"type": "output", "data": "        debugSaveFrameIfRequested(frame)\r\n        val yolo = yoloDetector ?: run {\r\n", "ts": 1790300051.5564504}
