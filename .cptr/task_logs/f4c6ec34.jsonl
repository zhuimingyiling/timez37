{"type": "output", "data": "    private fun startCapture(resultCode: Int, data: Intent?) {\r\n", "ts": 1790300051.549708}
{"type": "output", "data": "        if (mediaProjection != null || data == null) return\r\n", "ts": 1790300051.549708}
{"type": "output", "data": "        overlayClosed = false\r\n", "ts": 1790300051.549708}
{"type": "output", "data": "        paused = false\r\n", "ts": 1790300051.549708}
{"type": "output", "data": "        val metrics = screenMetrics()\r\n", "ts": 1790300051.549708}
{"type": "output", "data": "        val w = metrics.widthPixels\r\n", "ts": 1790300051.549708}
{"type": "output", "data": "        val h = metrics.heightPixels\r\n        val dpi = metrics.densityDpi\r\n", "ts": 1790300051.550233}
{"type": "output", "data": "\r\n", "ts": 1790300051.550233}
{"type": "output", "data": "        mediaProjection = projectionManager.getMediaProjection(resultCode, data)\r\n", "ts": 1790300051.550233}
{"type": "output", "data": "        config.frameSize = w to h\r\n", "ts": 1790300051.550233}
{"type": "output", "data": "        val reader = ImageReader.newInstance(w, h, PixelFormat.RGBA_8888, 2)\r\n", "ts": 1790300051.550233}
{"type": "output", "data": "        reader.setOnImageAvailableListener(::onImageAvailable, frameHandler)\r\n", "ts": 1790300051.550233}
{"type": "output", "data": "        imageReader = reader\r\n", "ts": 1790300051.550233}
{"type": "output", "data": "        virtualDisplay = mediaProjection?.createVirtualDisplay(\r\n", "ts": 1790300051.550233}
{"type": "output", "data": "            \"assist-capture\", w, h, dpi,\r\n", "ts": 1790300051.550233}
{"type": "output", "data": "            DisplayManager.VIRTUAL_DISPLAY_FLAG_AUTO_MIRROR,\r\n", "ts": 1790300051.550233}
{"type": "output", "data": "            reader.surface, null, workerHandler\r\n", "ts": 1790300051.550233}
{"type": "output", "data": "        )\r\n", "ts": 1790300051.550737}
{"type": "output", "data": "        Log.i(TAG, \"capture started: ${w}x$h\")\r\n", "ts": 1790300051.550737}
{"type": "output", "data": "\r\n        val engineMode = config.engineMode\r\n", "ts": 1790300051.550737}
{"type": "output", "data": "        analysisEngine = when (engineMode) {\r\n", "ts": 1790300051.550737}
{"type": "output", "data": "            \"remote\" -> RemoteAnalysisEngine(\r\n", "ts": 1790300051.550737}
{"type": "output", "data": "                host = config.remoteHost,\r\n", "ts": 1790300051.550737}
{"type": "output", "data": "                port = config.remotePort,\r\n", "ts": 1790300051.550737}
{"type": "output", "data": "                listener = analysisListener,\r\n", "ts": 1790300051.550737}
{"type": "output", "data": "                initialDepth = config.searchDepth,\r\n", "ts": 1790300051.550737}
{"type": "output", "data": "                initialThreads = config.threads\r\n", "ts": 1790300051.550737}
{"type": "output", "data": "            )\r\n            else -> AnalysisEngine(\r\n", "ts": 1790300051.550737}
{"type": "output", "data": "                this, analysisListener, config.searchDepth,\r\n", "ts": 1790300051.550737}
{"type": "output", "data": "                initialThreads = config.threads\r\n", "ts": 1790300051.550737}
{"type": "output", "data": "            )\r\n", "ts": 1790300051.551237}
{"type": "output", "data": "        }\r\n", "ts": 1790300051.551237}
