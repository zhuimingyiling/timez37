{"type": "output", "data": "    private fun onImageAvailable(reader: ImageReader) {\r\n", "ts": 1790300051.5517707}
{"type": "output", "data": "        val now = System.currentTimeMillis()\r\n        val slowPath = !userDragging && overlayIntersectsBoard()\r\n", "ts": 1790300051.5517707}
{"type": "output", "data": "        val interval = if (slowPath) OVERLAY_FRAME_INTERVAL_MS else MIN_FRAME_INTERVAL_MS\r\n        if (now - lastFrameTs < interval) {\r\n", "ts": 1790300051.5517707}
{"type": "output", "data": "            reader.acquireLatestImage()?.close()\r\n", "ts": 1790300051.5517707}
{"type": "output", "data": "            return\r\n", "ts": 1790300051.5517707}
{"type": "output", "data": "        }\r\n", "ts": 1790300051.5517707}
{"type": "output", "data": "        lastFrameTs = now\r\n", "ts": 1790300051.5517707}
{"type": "output", "data": "        var needRestoreHide = false\r\n", "ts": 1790300051.5517707}
{"type": "output", "data": "        try {\r\n", "ts": 1790300051.5517707}
{"type": "output", "data": "            val needHide = slowPath && (overlayPanel?.alpha ?: 0f) > 0f\r\n", "ts": 1790300051.5517707}
{"type": "output", "data": "            if (needHide) {\r\n", "ts": 1790300051.5517707}
{"type": "output", "data": "                mainHandler.post { overlayPanel?.alpha = 0f }\r\n", "ts": 1790300051.5517707}
{"type": "output", "data": "                needRestoreHide = true\r\n", "ts": 1790300051.5517707}
{"type": "output", "data": "                Thread.sleep(60)\r\n", "ts": 1790300051.5517707}
{"type": "output", "data": "            }\r\n", "ts": 1790300051.5517707}
{"type": "output", "data": "            val image = reader.acquireLatestImage() ?: return\r\n", "ts": 1790300051.5517707}
{"type": "output", "data": "            try {\r\n", "ts": 1790300051.5522711}
{"type": "output", "data": "                val frame = imageToFrame(image)\r\n", "ts": 1790300051.5522711}
{"type": "output", "data": "                if (!pendingFrame) {\r\n", "ts": 1790300051.5522711}
{"type": "output", "data": "                    pendingFrame = true\r\n", "ts": 1790300051.5522711}
{"type": "output", "data": "                    workerHandler.post { pendingFrame = false; handleFrame(frame) }\r\n", "ts": 1790300051.5522711}
{"type": "output", "data": "                }\r\n", "ts": 1790300051.5522711}
{"type": "output", "data": "            } finally {\r\n", "ts": 1790300051.5522711}
{"type": "output", "data": "                image.close()\r\n", "ts": 1790300051.5522711}
{"type": "output", "data": "            }\r\n", "ts": 1790300051.5522711}
{"type": "output", "data": "        } catch (e: Exception) {\r\n", "ts": 1790300051.5522711}
{"type": "output", "data": "            Log.w(TAG, \"onImageAvailable failed\", e)\r\n", "ts": 1790300051.5522711}
{"type": "output", "data": "        } finally {\r\n", "ts": 1790300051.5522711}
{"type": "output", "data": "            if (needRestoreHide) {\r\n", "ts": 1790300051.5527744}
{"type": "output", "data": "                mainHandler.post { overlayPanel?.alpha = 1f }\r\n", "ts": 1790300051.5527744}
{"type": "output", "data": "            }\r\n", "ts": 1790300051.5527744}
{"type": "output", "data": "        }\r\n", "ts": 1790300051.5527744}
{"type": "output", "data": "    }\r\n", "ts": 1790300051.5527744}
{"type": "output", "data": "\r\n", "ts": 1790300051.5527744}
{"type": "output", "data": "    private var frameRowBytes: ByteArray? = null\r\n", "ts": 1790300051.5527744}
{"type": "output", "data": "\r\n    private fun imageToFrame(image: Image): Frame {", "ts": 1790300051.5527744}
{"type": "output", "data": "\r\n", "ts": 1790300051.5527744}
{"type": "output", "data": "        val plane = image.planes[0]\r\n", "ts": 1790300051.553383}
{"type": "output", "data": "        val rowStride = plane.rowStride\r\n        val pixelStride = plane.pixelStride\r\n        val buffer = plane.buffer\r\n        val w = image.width\r\n        val h = image.height\r\n        val px = IntArray(w * h)\r\n        if (pixelStride == 4) {\r\n            var row = frameRowBytes\r\n            if (row == null || row.size < w * 4) row = ByteArray(w * 4)\r\n", "ts": 1790300051.553383}
{"type": "output", "data": "            frameRowBytes = row\r\n            var p = 0\r\n", "ts": 1790300051.553383}
{"type": "output", "data": "            for (y in 0 until h) {\r\n", "ts": 1790300051.553383}
{"type": "output", "data": "                buffer.position(y * rowStride)\r\n", "ts": 1790300051.553383}
{"type": "output", "data": "                buffer.get(row, 0, w * 4)\r\n", "ts": 1790300051.553383}
{"type": "output", "data": "                var i = 0\r\n", "ts": 1790300051.5538867}
{"type": "output", "data": "                while (i < w * 4) {\r\n                    px[p++] = (0xFF shl 24) or\r\n", "ts": 1790300051.5538867}
{"type": "output", "data": "                            ((row[i].toInt() and 0xFF) shl 16) or\r\n", "ts": 1790300051.5538867}
{"type": "output", "data": "                            ((row[i + 1].toInt() and 0xFF) shl 8) or\r\n", "ts": 1790300051.5538867}
{"type": "output", "data": "                            (row[i + 2].toInt() and 0xFF)\r\n", "ts": 1790300051.5538867}
{"type": "output", "data": "                    i += 4\r\n", "ts": 1790300051.5538867}
{"type": "output", "data": "                }\r\n            }\r\n", "ts": 1790300051.5538867}
{"type": "output", "data": "        } else {\r\n", "ts": 1790300051.5538867}
{"type": "output", "data": "            for (y in 0 until h) {\r\n", "ts": 1790300051.5538867}
{"type": "output", "data": "                val rowStart = y * rowStride\r\n                for (x in 0 until w) {\r\n", "ts": 1790300051.5538867}
{"type": "output", "data": "                    val off = rowStart + x * pixelStride\r\n", "ts": 1790300051.5538867}
{"type": "output", "data": "                    val r = buffer.get(off).toInt() and 0xFF\r\n", "ts": 1790300051.5543878}
{"type": "output", "data": "                    val g = buffer.get(off + 1).toInt() and 0xFF\r\n                    val b = buffer.get(off + 2).toInt() and 0xFF\r\n", "ts": 1790300051.5543878}
{"type": "output", "data": "                    px[y * w + x] = (0xFF shl 24) or (r shl 16) or (g shl 8) or b\r\n", "ts": 1790300051.5543878}
{"type": "output", "data": "                }\r\n", "ts": 1790300051.5543878}
{"type": "output", "data": "            }\r\n", "ts": 1790300051.5543878}
{"type": "output", "data": "        }\r\n", "ts": 1790300051.5543878}
{"type": "output", "data": "        return Frame(w, h, px)\r\n", "ts": 1790300051.5543878}
{"type": "output", "data": "    }\r\n", "ts": 1790300051.5543878}
{"type": "output", "data": "\r\n", "ts": 1790300051.5543878}
{"type": "output", "data": "    private fun debugSaveFrameIfRequested(frame: Frame) {\r\n", "ts": 1790300051.5543878}
{"type": "output", "data": "        if (!BuildConfig.DEBUG) return\r\n", "ts": 1790300051.5543878}
{"type": "output", "data": "        val trigger = File(\"/sdcard/assist_debug_save\")\r\n", "ts": 1790300051.5543878}
{"type": "output", "data": "        if (!trigger.exists()) return\r\n", "ts": 1790300051.5543878}
{"type": "output", "data": "        trigger.delete()\r\n", "ts": 1790300051.554909}
{"type": "output", "data": "        try {\r\n", "ts": 1790300051.554909}
{"type": "output", "data": "            val dir = getExternalFilesDir(null) ?: filesDir\r\n", "ts": 1790300051.554909}
{"type": "output", "data": "            val outPath = File(dir, \"assist_frame.raw\").absolutePath\r\n", "ts": 1790300051.554909}
{"type": "output", "data": "            DataOutputStream(FileOutputStream(outPath)).use { out ->\r\n", "ts": 1790300051.554909}
{"type": "output", "data": "                out.writeInt(0x41534652)\r\n", "ts": 1790300051.554909}
{"type": "output", "data": "                out.writeInt(frame.width)\r\n                out.writeInt(frame.height)\r\n", "ts": 1790300051.554909}
{"type": "output", "data": "                for (p in frame.argb) {\r\n", "ts": 1790300051.554909}
{"type": "output", "data": "                    out.writeByte((p shr 16) and 0xFF)\r\n", "ts": 1790300051.554909}
{"type": "output", "data": "                    out.writeByte((p shr 8) and 0xFF)\r\n", "ts": 1790300051.554909}
{"type": "output", "data": "                    out.writeByte(p and 0xFF)\r\n", "ts": 1790300051.554909}
{"type": "output", "data": "                }\r\n", "ts": 1790300051.554909}
{"type": "output", "data": "            }\r\n", "ts": 1790300051.554909}
{"type": "output", "data": "            Log.i(TAG, \"debug frame saved $outPath\")\r\n", "ts": 1790300051.555409}
{"type": "output", "data": "        } catch (e: Exception) {\r\n", "ts": 1790300051.555409}
{"type": "output", "data": "            Log.w(TAG, \"debug frame save failed\", e)\r\n", "ts": 1790300051.555409}
{"type": "output", "data": "        }\r\n", "ts": 1790300051.555409}
