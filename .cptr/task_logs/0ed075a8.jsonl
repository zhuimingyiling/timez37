{"type": "output", "data": "        override fun onSearchUpdate(result: AnalysisResult) {\r\n", "ts": 1790300074.0142946}
{"type": "output", "data": "            if (result.fen != currentFen) return\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "            lastAnalysis = result\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "            val best = result.lines.firstOrNull()?.pv?.firstOrNull() ?: result.bestUcci\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "            if (best != stableUcci) {\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "                stableUcci = best\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "                stableSince = System.currentTimeMillis()\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "                searchSettled = false\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "            }\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "            postRender()\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "        }\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "        override fun onSearchDone(result: AnalysisResult) {\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "            if (result.fen != currentFen) return\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "            lastAnalysis = result\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "            searchSettled = true\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "            mainHandler.post {\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "                setStatus(\"\u8bc6\u522b\u4e2d\")\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "                postRender()\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "            }\r\n", "ts": 1790300074.0147946}
