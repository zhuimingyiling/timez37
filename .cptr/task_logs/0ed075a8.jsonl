{"type": "output", "data": "    private fun scheduleAnalysis() {\r\n", "ts": 1790300074.0127647}
{"type": "output", "data": "        workerHandler.post {\r\n", "ts": 1790300074.0127647}
{"type": "output", "data": "            val canonical = currentCanonical ?: return@post\r\n", "ts": 1790300074.0127647}
{"type": "output", "data": "            val fen = currentFen\r\n", "ts": 1790300074.0127647}
{"type": "output", "data": "            if (fen.isEmpty()) return@post\r\n", "ts": 1790300074.0127647}
{"type": "output", "data": "            val redGo = tracker.redGo\r\n", "ts": 1790300074.0127647}
{"type": "output", "data": "            val myTurn = redGo == mySideIsRed()\r\n", "ts": 1790300074.0127647}
{"type": "output", "data": "            if (myTurn) {\r\n", "ts": 1790300074.0127647}
{"type": "output", "data": "                val moves = queryBook(canonical, redGo)\r\n", "ts": 1790300074.0127647}
{"type": "output", "data": "                if (!moves.isNullOrEmpty()) {\r\n", "ts": 1790300074.0127647}
{"type": "output", "data": "                    bookMoves = moves\r\n", "ts": 1790300074.0127647}
{"type": "output", "data": "                    mainHandler.post { postRender() }\r\n", "ts": 1790300074.0132654}
{"type": "output", "data": "                    return@post\r\n", "ts": 1790300074.0132654}
{"type": "output", "data": "                }\r\n", "ts": 1790300074.0132654}
{"type": "output", "data": "            }\r\n", "ts": 1790300074.0132654}
{"type": "output", "data": "            bookMoves = null\r\n            if (!engineReady) {\r\n", "ts": 1790300074.0132654}
{"type": "output", "data": "                mainHandler.post { setStatus(engineErrorText ?: \"\u5f15\u64ce\u9884\u70ed\u4e2d\u2026\") }\r\n", "ts": 1790300074.0132654}
{"type": "output", "data": "                return@post\r\n", "ts": 1790300074.0132654}
{"type": "output", "data": "            }\r\n", "ts": 1790300074.0132654}
{"type": "output", "data": "            analysisEngine?.request(fen)\r\n", "ts": 1790300074.0132654}
{"type": "output", "data": "            if (myTurn) mainHandler.post { setStatus(\"\u5f15\u64ce\u601d\u8003\u4e2d\u2026\") }\r\n", "ts": 1790300074.0132654}
{"type": "output", "data": "        }\r\n    }\r\n", "ts": 1790300074.0132654}
{"type": "output", "data": "\r\n", "ts": 1790300074.0132654}
{"type": "output", "data": "    private fun queryBook(canonical: Array<IntArray>, redGo: Boolean): List<BookData>? {\r\n", "ts": 1790300074.0137944}
{"type": "output", "data": "        if (openBookFailed) return null\r\n", "ts": 1790300074.0137944}
{"type": "output", "data": "        val book = openBook ?: try {\r\n            BHOpenBook(this).also { openBook = it }\r\n", "ts": 1790300074.0137944}
{"type": "output", "data": "        } catch (t: Throwable) {\r\n", "ts": 1790300074.0137944}
{"type": "output", "data": "            Log.w(TAG, \"openbook init failed\", t)\r\n", "ts": 1790300074.0137944}
{"type": "output", "data": "            openBookFailed = true\r\n", "ts": 1790300074.0137944}
{"type": "output", "data": "            return null\r\n", "ts": 1790300074.0137944}
{"type": "output", "data": "        }\r\n", "ts": 1790300074.0137944}
{"type": "output", "data": "        return try {\r\n", "ts": 1790300074.0137944}
{"type": "output", "data": "            book.query(Zobrist.getZobristFromBoard(canonical, redGo), redGo, OpenBook.SortRule.BEST_SCORE)\r\n", "ts": 1790300074.0137944}
{"type": "output", "data": "        } catch (t: Throwable) {\r\n", "ts": 1790300074.0137944}
{"type": "output", "data": "            Log.w(TAG, \"book query failed\", t)\r\n", "ts": 1790300074.0142946}
{"type": "output", "data": "            null\r\n        }\r\n", "ts": 1790300074.0142946}
{"type": "output", "data": "    }\r\n", "ts": 1790300074.0142946}
{"type": "output", "data": "\r\n", "ts": 1790300074.0142946}
{"type": "output", "data": "    private val analysisListener = object : AnalysisEngine.Listener {\r\n", "ts": 1790300074.0142946}
{"type": "output", "data": "        override fun onEngineReady() {\r\n            engineReady = true\r\n", "ts": 1790300074.0142946}
{"type": "output", "data": "            engineErrorText = null\r\n", "ts": 1790300074.0142946}
