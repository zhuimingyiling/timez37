{"type": "output", "data": "        override fun onEngineError(message: String) {\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "            Log.w(TAG, \"engine error: $message\")\r\n", "ts": 1790300074.0147946}
{"type": "output", "data": "            if (overlayClosed) return\r\n", "ts": 1790300074.015765}
{"type": "output", "data": "            engineReady = false\r\n", "ts": 1790300074.015765}
{"type": "output", "data": "            val short = if (message.length > 40) message.take(40) + \"\u2026\" else message\r\n", "ts": 1790300074.015765}
{"type": "output", "data": "            engineErrorText = short\r\n            setStatus(\"\u5f15\u64ce\u5f02\u5e38\uff1a$short\")\r\n        }\r\n    }\r\n\r\n    // ==================== \u60ac\u6d6e\u7a97 ====================\r\n\r\n", "ts": 1790300074.015765}
{"type": "output", "data": "    private fun ensureOverlay(): OverlayPanelView? {\r\n", "ts": 1790300074.015765}
{"type": "output", "data": "        if (overlayPanel != null) return overlayPanel\r\n", "ts": 1790300074.015765}
{"type": "output", "data": "        if (!Settings.canDrawOverlays(this)) return null\r\n", "ts": 1790300074.016434}
{"type": "output", "data": "        val wm = getSystemService(WINDOW_SERVICE) as WindowManager\r\n", "ts": 1790300074.016434}
{"type": "output", "data": "        val panel = OverlayPanelView(this)\r\n", "ts": 1790300074.016434}
{"type": "output", "data": "        val dm = screenMetrics()\r\n        val (px0, py0) = config.overlayPos\r\n", "ts": 1790300074.016434}
{"type": "output", "data": "        val panelW = panel.dp(396)\r\n        val panelH = panel.dp(192)\r\n", "ts": 1790300074.016434}
{"type": "output", "data": "        val x = (if (px0 < 0) (dm.widthPixels - panelW) / 2 else (px0 * dm.widthPixels).toInt())\r\n            .coerceIn(0, max(0, dm.widthPixels - panelW))\r\n        val y = (if (py0 < 0) dm.heightPixels - panelH else (py0 * dm.heightPixels).toInt())\r\n            .coerceIn(0, max(0, dm.heightPixels - panelH))\r\n        val params = WindowManager.LayoutParams(\r\n            WindowManager.LayoutParams.WRAP_CONTENT,\r\n            WindowManager.LayoutParams.WRAP_CONTENT,\r\n            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,\r\n", "ts": 1790300074.016434}
{"type": "output", "data": "            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,\r\n", "ts": 1790300074.0172997}
{"type": "output", "data": "            PixelFormat.TRANSLUCENT\r\n", "ts": 1790300074.0172997}
{"type": "output", "data": "        ).apply {\r\n", "ts": 1790300074.0172997}
{"type": "output", "data": "            gravity = Gravity.TOP or Gravity.START\r\n", "ts": 1790300074.0172997}
{"type": "output", "data": "            this.x = x\r\n", "ts": 1790300074.0172997}
{"type": "output", "data": "            this.y = y\r\n", "ts": 1790300074.0172997}
{"type": "output", "data": "        }\r\n", "ts": 1790300074.0172997}
{"type": "output", "data": "        panel.onAction = ::onOverlayAction\r\n", "ts": 1790300074.0172997}
{"type": "output", "data": "        panel.onCellTap = ::onManualCellTap\r\n", "ts": 1790300074.0172997}
{"type": "output", "data": "        panel.onDragStateChange = { dragging -> userDragging = dragging }\r\n", "ts": 1790300074.0172997}
{"type": "output", "data": "        panel.setDragHandle(params, wm) {\r\n", "ts": 1790300074.0178084}
{"type": "output", "data": "            config.overlayPos = params.x.toFloat() / dm.widthPixels to params.y.toFloat() / dm.heightPixels\r\n", "ts": 1790300074.0178084}
{"type": "output", "data": "        }\r\n", "ts": 1790300074.0178084}
{"type": "output", "data": "        wm.addView(panel, params)\r\n", "ts": 1790300074.0178084}
{"type": "output", "data": "        overlayPanel = panel\r\n", "ts": 1790300074.0178084}
{"type": "output", "data": "        overlayParams = params\r\n", "ts": 1790300074.0178084}
{"type": "output", "data": "        windowManager = wm\r\n", "ts": 1790300074.0178084}
{"type": "output", "data": "        return panel\r\n", "ts": 1790300074.0178084}
{"type": "output", "data": "    }\r\n", "ts": 1790300074.0178084}
{"type": "output", "data": "\r\n", "ts": 1790300074.0178084}
{"type": "output", "data": "    private fun overlayIntersectsBoard(): Boolean {\r\n", "ts": 1790300074.0178084}
{"type": "output", "data": "        val panel = overlayPanel ?: return false\r\n", "ts": 1790300074.0178084}
{"type": "output", "data": "        val grid = sessionGrid ?: return false\r\n", "ts": 1790300074.0178084}
{"type": "output", "data": "        val params = overlayParams ?: return false\r\n", "ts": 1790300074.0178084}
{"type": "output", "data": "        if (panel.width <= 0 || panel.height <= 0) return false\r\n", "ts": 1790300074.0178084}
{"type": "output", "data": "        val (fw, fh) = config.frameSize\r\n", "ts": 1790300074.0178084}
{"type": "output", "data": "        if (fw <= 0 || fh <= 0) return false\r\n", "ts": 1790300074.0178084}
{"type": "output", "data": "        val bx0 = grid.nx0 * fw\r\n", "ts": 1790300074.0185726}
{"type": "output", "data": "        val by0 = grid.ny0 * fh\r\n", "ts": 1790300074.0185726}
{"type": "output", "data": "        val bx1 = grid.nx1 * fw\r\n", "ts": 1790300074.0185726}
{"type": "output", "data": "        val by1 = grid.ny1 * fh\r\n", "ts": 1790300074.0185726}
{"type": "output", "data": "        val px0 = params.x\r\n", "ts": 1790300074.0185726}
{"type": "output", "data": "        val py0 = params.y\r\n", "ts": 1790300074.0185726}
{"type": "output", "data": "        val px1 = px0 + panel.width\r\n", "ts": 1790300074.0185726}
{"type": "output", "data": "        val py1 = py0 + panel.height\r\n", "ts": 1790300074.0185726}
{"type": "output", "data": "        return px0 < bx1 && px1 > bx0 && py0 < by1 && py1 > by0\r\n", "ts": 1790300074.0185726}
{"type": "output", "data": "    }\r\n\r\n", "ts": 1790300074.0191104}
{"type": "output", "data": "    private fun onOverlayAction(action: OverlayAction) {\r\n", "ts": 1790300074.0191104}
{"type": "output", "data": "        when (action) {\r\n", "ts": 1790300074.0191104}
{"type": "output", "data": "            OverlayAction.PAUSE -> {\r\n", "ts": 1790300074.0191104}
{"type": "output", "data": "                paused = !paused\r\n", "ts": 1790300074.0191104}
{"type": "output", "data": "                setStatus(if (paused) \"\u5df2\u505c\u6b62\u6307\u5bfc\\n\u70b9\u300e\u7ee7\u7eed\u300f\u6062\u590d\" else \"\u7ee7\u7eed\u6307\u5bfc\")\r\n", "ts": 1790300074.0191104}
{"type": "output", "data": "            }\r\n", "ts": 1790300074.0191104}
{"type": "output", "data": "            OverlayAction.CLOSE -> {\r\n", "ts": 1790300074.0191104}
{"type": "output", "data": "                overlayClosed = true\r\n", "ts": 1790300074.0191104}
{"type": "output", "data": "                overlayPanel?.let { p -> runCatching { windowManager?.removeView(p) } }\r\n                overlayPanel = null\r\n", "ts": 1790300074.0191104}
{"type": "output", "data": "                paused = true\r\n", "ts": 1790300074.0196867}
{"type": "output", "data": "                releaseCapture()\r\n", "ts": 1790300074.0196867}
{"type": "output", "data": "                setStatus(\"\u5df2\u5173\u95ed\uff08\u8bc6\u522b\u4e0e\u5f55\u5c4f\u5747\u5df2\u505c\u6b62\uff0c\u53ef\u5728\u8fde\u7ebf\u9875\u91cd\u65b0\u542f\u52a8\uff09\")\r\n", "ts": 1790300074.0196867}
{"type": "output", "data": "                stopSelf()\r\n", "ts": 1790300074.0196867}
{"type": "output", "data": "            }\r\n", "ts": 1790300074.0196867}
{"type": "output", "data": "            OverlayAction.CYCLE_CANDIDATE -> {\r\n                val n = maxOf(bookMoves?.size ?: 0, lastAnalysis?.lines?.size ?: 0)\r\n", "ts": 1790300074.0196867}
{"type": "output", "data": "                if (n > 0) {\r\n", "ts": 1790300074.0196867}
{"type": "output", "data": "                    selectedCandidate = (selectedCandidate + 1) % n\r\n", "ts": 1790300074.0196867}
{"type": "output", "data": "                    postRender()\r\n", "ts": 1790300074.0196867}
{"type": "output", "data": "                }\r\n", "ts": 1790300074.0196867}
{"type": "output", "data": "            }\r\n", "ts": 1790300074.0196867}
{"type": "output", "data": "            OverlayAction.UNDO -> undoOneStep()\r\n", "ts": 1790300074.0196867}
{"type": "output", "data": "            OverlayAction.MANUAL -> toggleManualMode()\r\n", "ts": 1790300074.0203466}
{"type": "output", "data": "            OverlayAction.FLIP_TURN -> {\r\n", "ts": 1790300074.0203466}
{"type": "output", "data": "                tracker.redGo = !tracker.redGo\r\n", "ts": 1790300074.0203466}
{"type": "output", "data": "                resetSuggestionState()\r\n", "ts": 1790300074.0203466}
{"type": "output", "data": "                val canonical = currentCanonical\r\n", "ts": 1790300074.0203466}
{"type": "output", "data": "                if (canonical != null) {\r\n", "ts": 1790300074.0203466}
{"type": "output", "data": "                    currentFen = AssistBoard.toFen(canonical, tracker.redGo)\r\n", "ts": 1790300074.0203466}
{"type": "output", "data": "                }\r\n", "ts": 1790300074.0203466}
{"type": "output", "data": "                postRender()\r\n", "ts": 1790300074.0203466}
{"type": "output", "data": "                scheduleAnalysis()\r\n", "ts": 1790300074.0203466}
{"type": "output", "data": "                setStatus(\"\u68cb\u5c40\u5df2\u66f4\u65b0\\n\u73b0${if (tracker.redGo == mySideIsRed()) \"\u8f6e\u5230\u6211\u65b9\u8d70\" else \"\u8f6e\u5230\u5bf9\u65b9\u8d70\"}\")\r\n            }\r\n            OverlayAction.CYCLE_STRENGTH -> cycleStrength()", "ts": 1790300074.0254455}
{"type": "output", "data": "\r\n            OverlayAction.CYCLE_HASH -> cycleHash()\r\n        }\r\n    }\r\n\r\n    private fun undoOneStep() {\r\n        if (history.size <= 1) {\r\n            setStatus(\"\u6ca1\u6709\u53ef\u6094\u7684\u5c40\u9762\uff08\u4f1a\u968f\u5bf9\u5f08\u81ea\u52a8\u79ef\u7d2f\uff09\")\r\n            return\r\n        }\r\n        history.removeLast()\r\n        val prev = history.last()\r\n        tracker.restore(prev.result, prev.redGo)\r\n        currentCanonical = prev.result.canonical\r\n        currentPieces = flatten(prev.result.canonical)\r\n        currentOrientation = prev.result.orientation\r\n        currentFen = prev.fen\r\n        resetSuggestionState()\r\n        if (!manualMode) paused = true\r\n        postRender()\r\n        scheduleAnalysis()\r\n        setStatus(\"\u5df2\u6094\u68cb\u4e00\u6b65\\n\u70b9\u300e\u7ee7\u7eed\u300f\u6062\u590d\")\r\n    }\r\n\r\n    private fun toggleManualMode() {\r\n        manualMode = !manualMode\r\n        manualSelected = null\r\n        if (manualMode) {\r\n            if (currentCanonical == null) {\r\n                val start = AssistBoard.canonicalStart()\r\n                currentCanonical = start\r\n                currentPieces = flatten(start)\r\n                currentOrientation = Orientation.STANDARD\r\n                currentFen = AssistBoard.toFen(start, tracker.redGo)\r\n            }\r\n            val canonical = currentCanonical\r\n            if (canonical != null && history.lastOrNull()?.fen != currentFen) {\r\n                pushManualHistory(canonical, tracker.redGo)\r\n            }\r\n            setStatus(\"\u624b\u52a8\u6a21\u5f0f\uff08\u518d\u70b9\u624b\u52a8\u9000\u51fa\uff09\\n\u70b9\u5b50\u9009\u4e2d\u2192\u70b9\u76ee\u6807\u683c=\u8d70\u5b50\\n\u518d\u70b9\u9009\u4e2d\u5b50=\u5220\u9664\\n\u300e\u66f4\u65b0\u68cb\u5c40\u300f\u7ea0\u6b63\u8f6e\u6b21\")\r\n", "ts": 1790300074.0254455}
