{"type": "output", "data": "                if (tracker.unstableStreak >= 15) {\r\n", "ts": 1790300074.0105367}
{"type": "output", "data": "                    setStatus(\"\u8bc6\u522b\u4e0d\u7a33\u5b9a\\n\u8bf7\u8ba9\u68cb\u76d8\u5b8c\u6574\u65e0\u906e\u6321\\n\u753b\u9762\u7a33\u5b9a\u540e\u81ea\u52a8\u6062\u590d\")\r\n", "ts": 1790300074.0105367}
