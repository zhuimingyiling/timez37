{"type": "output", "data": "    private fun onBoardConfirmed() {\r\n", "ts": 1790300074.011053}
{"type": "output", "data": "        val confirmed = tracker.confirmed ?: return\r\n", "ts": 1790300074.011053}
{"type": "output", "data": "        currentCanonical = confirmed.canonical\r\n", "ts": 1790300074.011053}
{"type": "output", "data": "        currentPieces = flatten(confirmed.canonical)\r\n", "ts": 1790300074.011053}
{"type": "output", "data": "        currentOrientation = confirmed.orientation\r\n", "ts": 1790300074.011053}
{"type": "output", "data": "        currentFen = AssistBoard.toFen(confirmed.canonical, tracker.redGo)\r\n", "ts": 1790300074.011053}
{"type": "output", "data": "        resetSuggestionState()\r\n", "ts": 1790300074.011053}
{"type": "output", "data": "        history.addLast(HistoryEntry(confirmed, tracker.redGo, currentFen))\r\n", "ts": 1790300074.011053}
{"type": "output", "data": "        if (history.size > 60) history.removeFirst()\r\n", "ts": 1790300074.011053}
{"type": "output", "data": "        Log.i(TAG, \"board confirmed: $currentFen\")\r\n", "ts": 1790300074.0116796}
