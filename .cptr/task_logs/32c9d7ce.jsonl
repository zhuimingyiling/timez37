{"type": "output", "data": "    private val startBoard = canonicalStart()\r\n", "ts": 1790299945.3286428}
{"type": "output", "data": "\r\n", "ts": 1790299945.3286428}
{"type": "output", "data": "    fun matchStartCount(pieces: Array<IntArray>): Int {\r\n", "ts": 1790299945.3286428}
{"type": "output", "data": "        var n = 0\r\n", "ts": 1790299945.3286428}
